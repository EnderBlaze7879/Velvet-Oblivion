		{"id":"7aa7af8f9c3a677b","type":"text","text":"The teacher sees through the lie, seemingly more angry","x":3380,"y":-230,"width":240,"height":60},
		{"id":"2b276227455bc292","type":"text","text":"The teacher will take offense to this comment","x":3380,"y":-130,"width":240,"height":60},
		{"id":"0fbef9a8a8e28f41","type":"text","text":"The teacher will wait for a response","x":3380,"y":-40,"width":240,"height":60},
		{"id":"726dd779941f8ac1","type":"text","text":"Serein interrupts the situation.","x":3720,"y":-160,"width":220,"height":120},
		{"id":"8f1b6b2b1d0a3469","type":"text","text":"\"I'm sorry, I didn't get any sleep\"","x":3080,"y":-230,"width":240,"height":60,"color":"2"},
