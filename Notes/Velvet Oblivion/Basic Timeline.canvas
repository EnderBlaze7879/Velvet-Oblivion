		{"id":"aab3055056b3efc7","type":"text","text":"Follow Her","x":1260,"y":-180,"width":240,"height":60,"color":"2"},
		{"id":"8f4e0a3eb4720a44","type":"text","text":"Ignore Her","x":1260,"y":-80,"width":240,"height":60,"color":"2"},
		{"id":"eeb21b08ec0e26ab","type":"text","text":"MC follows Serein to class, not able to remember her name","x":1560,"y":-180,"width":240,"height":60},
		{"id":"0b419566df5103a4","type":"text","text":"MC and Serein sit there for a moment","x":1560,"y":-80,"width":240,"height":60},
		{"id":"9638db900b7a6d5e","type":"text","text":"Serein ends up getting impatient, going to class by herself, you following","x":1860,"y":-80,"width":250,"height":60},
		{"id":"e0323a0b2ca31200","type":"text","text":"MC ponders what Serein's name is, not paying attention to the lecture","x":2200,"y":-160,"width":220,"height":120},
