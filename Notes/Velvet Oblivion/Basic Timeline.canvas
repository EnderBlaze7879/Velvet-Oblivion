{
	"nodes":[
		{"id":"d31809af6a672e5a","type":"text","text":"MC is woken up by Serein","x":-20,"y":-160,"width":220,"height":120},
		{"id":"7859a28a353c16db","type":"text","text":"\"I've been awake...\"","x":295,"y":-130,"width":250,"height":60,"color":"2"},
		{"id":"5bc51c5977538ce5","type":"text","text":"\"Who are you?\"","x":295,"y":-230,"width":250,"height":60,"color":"2"},
		{"id":"40e29f995f6b801e","type":"text","text":"\"I don't know you.\"","x":295,"y":-40,"width":250,"height":60,"color":"2"},
		{"id":"bd4c389d532f5bf1","type":"text","text":"Serein laughs your comment off","x":600,"y":-230,"width":250,"height":60},
		{"id":"f111e45eedbd6d5b","type":"text","text":"Serein accuses you of lying about being awake, claiming you've been asleep all day","x":600,"y":-130,"width":250,"height":60},
		{"id":"f468f175799453f5","type":"text","text":"Serein tells you to stop messing with her","x":600,"y":-40,"width":250,"height":60},
		{"id":"c4a4bcb423fc4e91","type":"text","text":"# <p style=\"text-align: center\">START</p>","x":-740,"y":-160,"width":130,"height":120,"color":"1"},
